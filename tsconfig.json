{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "module": "commonjs",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "types": ["node"],
    "lib": [
      "dom",
      "es2017"
    ],
    "sourceMap": true,
    "target": "es2017"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/api/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/templates/*.ts"
  ]
}
